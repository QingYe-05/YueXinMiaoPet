<Window x:Class="YueXinMiaoPet.MainPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YueXinMiaoPet.Controls"
        Title="月薪喵桌宠"
        Icon="pack://siteoforigin:,,,/Assets/Icons/app.ico"
        Width="220"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove"
        MouseDoubleClick="OnMouseDoubleClick"
        MouseRightButtonUp="OnMouseRightButtonUp"
        StateChanged="OnStateChanged">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="CodexStatusBadge"
                Grid.Row="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                MaxWidth="260"
                Margin="4,0,4,6"
                Padding="10,6"
                CornerRadius="12"
                Background="#EAF5F3FF"
                BorderBrush="#AA7C88C8"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="CodexStatusTitleText"
                           Text="Codex：空闲"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#3B3F75"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" />
                <TextBlock x:Name="CodexStatusMessageText"
                           Text=""
                           FontSize="11"
                           Foreground="#4E527F"
                           MaxWidth="240"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="WeatherBadge"
                Grid.Row="1"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                MaxWidth="240"
                Margin="4,0,4,6"
                Padding="10,5"
                CornerRadius="12"
                Background="#DFFFFFFF"
                BorderBrush="#AA7A5A42"
                BorderThickness="1">
            <TextBlock x:Name="WeatherBadgeText"
                       Text="天气不可用"
                       FontSize="12"
                       Foreground="#5B3B2E"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center" />
        </Border>

        <controls:AnimatedGifImage x:Name="PetImage"
                                   Grid.Row="2"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
        <Border x:Name="FallbackPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="220"
                Padding="12"
                CornerRadius="14"
                Background="#EFFFFFFF"
                BorderBrush="#AA7A5A42"
                BorderThickness="1">
            <TextBlock x:Name="FallbackText"
                       Text="没有可用 GIF&#x0a;请右键托盘重新扫描"
                       FontSize="13"
                       Foreground="#5B3B2E"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
