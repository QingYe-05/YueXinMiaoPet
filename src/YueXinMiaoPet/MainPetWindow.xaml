<Window x:Class="YueXinMiaoPet.MainPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YueXinMiaoPet.Controls"
        Title="月薪喵桌宠"
        Icon="pack://siteoforigin:,,,/Assets/Icons/app.ico"
        Width="220"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewMouseLeftButtonDown="OnMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="OnMouseLeftButtonUp"
        PreviewMouseMove="OnMouseMove"
        MouseDoubleClick="OnMouseDoubleClick"
        MouseRightButtonUp="OnMouseRightButtonUp"
        StateChanged="OnStateChanged">
    <!-- 1/255 Alpha 肉眼不可见，但可避免 Win11 分层透明窗口的全透明区域偶发穿透点击。 -->
    <Grid Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="WeatherBadge"
                Grid.Row="0"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                MaxWidth="212"
                Margin="4,0,4,6"
                Padding="10,5"
                CornerRadius="12"
                Background="#DFFFFFFF"
                BorderBrush="#AA7A5A42"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="WeatherBadgeText"
                       Text="天气不可用"
                       FontSize="12"
                       Foreground="#5B3B2E"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center" />
        </Border>

        <controls:AnimatedGifImage x:Name="PetImage"
                                   Grid.Row="1"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" />
        <Border x:Name="FallbackPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="220"
                Padding="12"
                CornerRadius="14"
                Background="#EFFFFFFF"
                BorderBrush="#AA7A5A42"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="FallbackText"
                       Text="没有可用 GIF&#x0a;请右键托盘重新扫描"
                       FontSize="13"
                       Foreground="#5B3B2E"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
